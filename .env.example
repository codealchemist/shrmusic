# Copy to .env and adjust. Server-only: these values are never sent to the browser.

# Folder whose subfolders become albums. Absolute, ~/..., or relative to this project.
MUSIC_ROOT=./music

# Path(s) inside each album to list audio from, searched recursively.
# Separate several with commas. * matches one folder, ** any depth. Empty = every audio file.
MUSIC_MATCH=mp3/parts/

# API port (the dev UI runs on 5173 and proxies to it).
PORT=4321
